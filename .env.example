# =========================
# Application
# =========================
APP_NAME=Cartly
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_BASE_PATH=

# =========================
# Database (MySQL - XAMPP)
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cartly
DB_USER=root
DB_PASSWORD=

# =========================
# Security
# =========================
SESSION_SECRET=change_this_secret_key

# =========================
# Optional (future use)
# =========================
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASS=

